# Local Postgres (docker-compose.yml). DATABASE_URL is the migration/owner role — only
# `prisma migrate` should use it. The running application uses DATABASE_RUNTIME_URL, a
# least-privilege role that cannot UPDATE/DELETE audit_logs (doc 12 §12.7).
DATABASE_URL="postgresql://app:app_dev_password@localhost:5433/ai_task_manager?schema=public"
DATABASE_RUNTIME_URL="postgresql://app_runtime:app_runtime_dev_password@localhost:5433/ai_task_manager?schema=public"

# Session signing secret (Phase 1 local auth — see docs/architecture/14-phase1-implementation-deviations.md)
SESSION_SECRET="dev-only-change-me-to-a-long-random-string"

# Local file storage adapter (Phase 1 StorageService — see doc 14)
STORAGE_LOCAL_DIR="./storage/local"

# Feature flags
AI_FEATURES_ENABLED="false"
