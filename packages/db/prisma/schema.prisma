// Prisma schema — implements docs/architecture/03-database-erd.md
// Additive fields beyond doc 03 (called out inline) satisfy the confirmed decision in
// doc 13 #9/#12 and the "Third Required Workflow" (cross-department origin retention):
// Task gains originOrganizationId/originDepartmentId/originTeamId/originAssignorId,
// set once and never overwritten as the assignment chain moves.
//
// `passwordHash` on User is a Phase 1 local-auth field — see
// docs/architecture/14-phase1-implementation-deviations.md. It is not part of the
// Supabase-Auth-based design and is dropped when that swap happens.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────

enum WorkspaceType {
  PERSONAL
  ORGANIZATION
}

enum OrgMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// doc 05 — task lifecycle. OVERDUE is intentionally NOT a stored state (derived).
enum TaskStatus {
  DRAFT
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  COMPLETED
  CANCELLED
}

enum TaskCreatedVia {
  DIRECT
  AI
}

enum AssigneeType {
  USER
  TEAM
}

// doc 06 — per-assignment acknowledgement lifecycle.
enum AssignmentStatus {
  PENDING_ACKNOWLEDGEMENT
  ACCEPTED
  DECLINED
  SUPERSEDED
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

enum AuditSource {
  UI
  API
  AI
  SYSTEM
}

enum DeliveryChannel {
  IN_APP
  PUSH
  EMAIL
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

// Phase 2C — docs/architecture/17-phase2c-project-workspace-architecture-report.md §4.
// Purely presentational (icon/label/which Overview sections are emphasized) — drives no
// authorization, task, conversation, or file behavior. "Annual Day 2026" is a Project row
// with kind=EVENT; everything else about it works exactly like any other Project.
enum ProjectKind {
  PROJECT
  EVENT
}

enum DependencyType {
  BLOCKS
  RELATES_TO
}

// Phase 3 — docs/architecture/19-phase3-daily-work-cycle-architecture-report.md §12/§22.
// The daily-plan-local status of one DailyPlanItem — deliberately independent of
// Task.status (doc 19 §10): a task can be Task.status=IN_PROGRESS while its
// DailyPlanItem.status is still PLANNED (accepted long ago, not touched today) or
// CARRIED_FORWARD (touched yesterday, not today).
enum DailyPlanItemStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED_TODAY
  CARRIED_FORWARD
  MOVED_TO_BACKLOG
  DROPPED_FOR_TODAY
}

enum ScopeType {
  ORGANIZATION
  DEPARTMENT
  TEAM
}

// ─────────────────────────────────────────────────────────────────────────
// Identity & tenancy
// ─────────────────────────────────────────────────────────────────────────

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  fullName         String   @map("full_name")
  avatarUrl        String?  @map("avatar_url")
  defaultTimezone  String   @default("UTC") @map("default_timezone")
  passwordHash     String   @map("password_hash") // Phase 1 local auth only — see doc 14
  // Phase 3 — docs/architecture/19-phase3-daily-work-cycle-architecture-report.md §12/§16.
  // Optional per-weekday {start,end} in "HH:mm"; null means "use the system default
  // (Mon-Fri 09:00-17:00)" applied in application code. Advisory input to capacity math
  // only — never an enforcement boundary on when a user may act (doc 19 §16/§22).
  workingHours     Json?    @map("working_hours")
  createdAt        DateTime @default(now()) @map("created_at")

  organizationMemberships OrganizationMember[]
  createdOrganizations    Organization[]        @relation("OrgCreatedBy")
  createdDepartments      Department[]          @relation("DeptCreatedBy")
  createdTeams            Team[]                @relation("TeamCreatedBy")
  teamMemberships         TeamMember[]
  userRoles               UserRole[]            @relation("UserRoleHolder")
  grantedRoles            UserRole[]            @relation("UserRoleGrantedBy")
  ownedWorkspaces         Workspace[]
  ownedProjects           Project[]
  createdTasks            Task[]                @relation("TaskCreatedBy")
  assignmentsMade         TaskAssignment[]      @relation("AssignmentAssignedBy")
  assignmentsReceived     TaskAssignment[]      @relation("AssignmentAssigneeUser")
  assignmentsRespondedTo  TaskAssignment[]      @relation("AssignmentRespondedBy")
  checklistItemsCreated   TaskChecklistItem[]
  comments                TaskComment[]
  updates                 TaskUpdate[]
  attachmentsUploaded     TaskAttachment[]
  reviews                 TaskReview[]
  notifications           Notification[]
  auditLogsAsActor        AuditLog[]
  originAssignedTasks     Task[]                @relation("TaskOriginAssignor")
  aiInteractions          AiInteraction[]
  sentMessages            TaskMessage[]
  messageMentions         TaskMessageMention[]
  messageReactions        TaskMessageReaction[]
  conversationReads       TaskConversationRead[]
  projectMemberships      ProjectMember[]         @relation("ProjectMemberUser")
  projectMembersAdded     ProjectMember[]         @relation("ProjectMemberAddedBy")
  projectTeamsAdded       ProjectTeam[]
  projectDatesCreated     ProjectDate[]
  workdays                Workday[]

  @@map("users")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  settings    Json     @default("{}")
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy   User                  @relation("OrgCreatedBy", fields: [createdById], references: [id])
  members     OrganizationMember[]
  departments Department[]
  teams       Team[]
  roles       Role[]
  userRoles   UserRole[]
  workspaces  Workspace[]
  tags        Tag[]
  auditLogs   AuditLog[]
  aiInteractions AiInteraction[]
  originTasks Task[]          @relation("TaskOriginOrganization")

  @@map("organizations")
}

model OrganizationMember {
  id             String          @id @default(uuid())
  organizationId String          @map("organization_id")
  userId         String          @map("user_id")
  status         OrgMemberStatus @default(ACTIVE)
  joinedAt       DateTime        @default(now()) @map("joined_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

// ─────────────────────────────────────────────────────────────────────────
// Departments & teams
// ─────────────────────────────────────────────────────────────────────────

model Department {
  id                   String   @id @default(uuid())
  organizationId       String   @map("organization_id")
  parentDepartmentId   String?  @map("parent_department_id")
  name                 String
  createdById          String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentDepartment Department?  @relation("DeptHierarchy", fields: [parentDepartmentId], references: [id])
  childDepartments Department[] @relation("DeptHierarchy")
  createdBy        User         @relation("DeptCreatedBy", fields: [createdById], references: [id])
  teams            Team[]
  projects         Project[]
  originTasks      Task[]       @relation("TaskOriginDepartment")

  @@index([organizationId])
  @@map("departments")
}

model Team {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  departmentId   String?  @map("department_id")
  name           String
  createdById    String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department           Department?      @relation(fields: [departmentId], references: [id])
  createdBy            User             @relation("TeamCreatedBy", fields: [createdById], references: [id])
  members              TeamMember[]
  projects             Project[]
  assignmentsAsAssignee TaskAssignment[] @relation("AssignmentAssigneeTeam")
  originTasks          Task[]           @relation("TaskOriginTeam")
  projectTeams          ProjectTeam[]

  @@index([organizationId])
  @@index([departmentId])
  @@map("teams")
}

model TeamMember {
  id       String   @id @default(uuid())
  teamId   String   @map("team_id")
  userId   String   @map("user_id")
  isHead   Boolean  @default(false) @map("is_head")
  joinedAt DateTime @default(now()) @map("joined_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

// ─────────────────────────────────────────────────────────────────────────
// RBAC (doc 04)
// ─────────────────────────────────────────────────────────────────────────

model Role {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id") // null = system template role
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at")

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  roleId         String    @map("role_id")
  organizationId String    @map("organization_id")
  scopeType      ScopeType @map("scope_type")
  scopeId        String?   @map("scope_id") // department_id or team_id; null when scopeType=ORGANIZATION
  grantedById    String    @map("granted_by")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User         @relation("UserRoleHolder", fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy    User         @relation("UserRoleGrantedBy", fields: [grantedById], references: [id])

  @@index([userId, organizationId])
  @@index([organizationId, scopeType, scopeId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────────────────
// Workspaces & projects
// ─────────────────────────────────────────────────────────────────────────

model Workspace {
  id             String        @id @default(uuid())
  type           WorkspaceType
  ownerUserId    String?       @map("owner_user_id") // set iff type=PERSONAL
  organizationId String?       @map("organization_id") // set iff type=ORGANIZATION
  name           String
  createdAt      DateTime      @default(now()) @map("created_at")

  // Cascade (not the Prisma default of nulling the FK) — a personal workspace's
  // owner_user_id must always satisfy the workspaces_owner_xor_org_check constraint, so
  // deleting the owning user has to delete their personal workspace, never null it out.
  owner        User?        @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  // Same reasoning as `owner` above, for the organization-workspace side of the check.
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]
  tasks        Task[]

  @@index([ownerUserId])
  @@index([organizationId])
  @@map("workspaces")
  // CHECK (exactly one of owner_user_id / organization_id set) added via raw-SQL migration
}

// Phase 1 model, minimally wired until Phase 2C — docs/architecture/17-phase2c-
// project-workspace-architecture-report.md §2/§6.1. Extended here (additive columns +
// new relations only), never replaced: workspaceId/departmentId/teamId/ownerId/status
// already correctly answer "which tenant, and which department/team gets credit for
// creating it" — a different question from "who participates," which the new
// ProjectMember/ProjectTeam rosters below answer (doc 17 §6.2/§6.3/§8).
model Project {
  id           String        @id @default(uuid())
  workspaceId  String        @map("workspace_id")
  departmentId String?       @map("department_id")
  teamId       String?       @map("team_id")
  name         String
  description  String?
  ownerId      String        @map("owner_id")
  status       ProjectStatus @default(ACTIVE)
  kind         ProjectKind   @default(PROJECT)
  startDate    DateTime?     @map("start_date") @db.Date
  targetDate   DateTime?     @map("target_date") @db.Date
  createdAt    DateTime      @default(now()) @map("created_at")

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  department   Department?       @relation(fields: [departmentId], references: [id])
  team         Team?             @relation(fields: [teamId], references: [id])
  owner        User              @relation(fields: [ownerId], references: [id])
  tasks        Task[]
  members      ProjectMember[]
  teams        ProjectTeam[]
  dates        ProjectDate[]
  conversation Conversation?
  attachments  TaskAttachment[]
  auditLogs    AuditLog[]        @relation("AuditLogProject")

  @@index([workspaceId])
  @@map("projects")
}

// Phase 2C — doc 17 §6.2. Explicit individual-participant roster for the People tab and
// for project-level access (doc 17 §8/§9). Authoritative for PROJECT-level access only —
// never for task-level accountability, which TaskAssignment alone continues to own
// unconditionally.
model ProjectMember {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  addedById   String   @map("added_by")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User    @relation("ProjectMemberAddedBy", fields: [addedById], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

// Phase 2C — doc 17 §6.3. "This team participates in this project" — a declarative
// membership decision (unlike a pending task-team-assignment), so unlike Phase 2A's
// task-conversation narrowing, every current member of a participating team gets
// baseline PROJECT-level access (doc 17 §8 explains why that's correct, not a
// regression). Membership is read live off TeamMember, never snapshotted.
model ProjectTeam {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  teamId    String   @map("team_id")
  addedById String   @map("added_by")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  addedBy User    @relation(fields: [addedById], references: [id])

  @@unique([projectId, teamId])
  @@index([teamId])
  @@map("project_teams")
}

// Phase 2C — doc 17 §6.6/§13. A labeled date, nothing more — deliberately not the
// Calendar module (no recurrence, no reminders, no time-of-day) and deliberately not
// linked to any Task.dueDate (a project milestone like "Guest Confirmation" isn't
// necessarily one task's deadline).
model ProjectDate {
  id          String    @id @default(uuid())
  projectId   String    @map("project_id")
  title       String
  date        DateTime  @db.Date
  notes       String?
  createdById String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([projectId, date])
  @@map("project_dates")
}

// ─────────────────────────────────────────────────────────────────────────
// Tasks & the assignment chain (doc 05, doc 06) — the core of the system
// ─────────────────────────────────────────────────────────────────────────

model Task {
  id                        String         @id @default(uuid())
  workspaceId               String         @map("workspace_id")
  projectId                 String?        @map("project_id")
  parentTaskId              String?        @map("parent_task_id")
  title                     String
  description               String?
  priority                  TaskPriority   @default(MEDIUM)
  status                    TaskStatus     @default(UNASSIGNED)
  startDate                 DateTime?      @map("start_date") @db.Date
  dueDate                   DateTime?      @map("due_date")
  estimatedDurationMinutes  Int?           @map("estimated_duration_minutes")
  createdById               String         @map("created_by")
  createdVia                TaskCreatedVia @default(DIRECT) @map("created_via")

  // Origin fields — set once (at creation / first assignment) and NEVER overwritten by
  // later reassignment. Required by doc 13 #9/#12 and the cross-department test scenario.
  originOrganizationId String? @map("origin_organization_id")
  originDepartmentId   String? @map("origin_department_id")
  originTeamId         String? @map("origin_team_id")
  originAssignorId     String? @map("origin_assignor_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project           Project?            @relation(fields: [projectId], references: [id])
  parentTask        Task?               @relation("TaskSubtasks", fields: [parentTaskId], references: [id])
  subtasks          Task[]              @relation("TaskSubtasks")
  createdBy         User                @relation("TaskCreatedBy", fields: [createdById], references: [id])
  originOrganization Organization?      @relation("TaskOriginOrganization", fields: [originOrganizationId], references: [id])
  originDepartment  Department?         @relation("TaskOriginDepartment", fields: [originDepartmentId], references: [id])
  originTeam        Team?               @relation("TaskOriginTeam", fields: [originTeamId], references: [id])
  originAssignor    User?               @relation("TaskOriginAssignor", fields: [originAssignorId], references: [id])

  assignments       TaskAssignment[]
  checklistItems    TaskChecklistItem[]
  comments          TaskComment[]
  updates           TaskUpdate[]
  attachments       TaskAttachment[]
  dependencies      TaskDependency[]    @relation("DependentTask")
  dependedOnBy      TaskDependency[]    @relation("DependsOnTask")
  reviews           TaskReview[]
  tags              TaskTag[]
  notifications     Notification[]
  // Phase 2A — docs/architecture/15-task-conversation.md. Exactly one per task, enforced
  // by the unique constraint on Conversation.taskId (widened for Phase 2C — doc 17 §6.4).
  conversation      Conversation?
  auditLogs         AuditLog[]          @relation("AuditLogTask")
  // Phase 3 — docs/architecture/19-phase3-daily-work-cycle-architecture-report.md §13.
  // A task may appear on any number of daily plan entries across different days (never
  // more than one per single day — enforced by DailyPlanItem's own unique constraint) —
  // this Task row is always the source of truth; DailyPlanItem only ever references it.
  dailyPlanItems    DailyPlanItem[]

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
  @@index([originOrganizationId])
  @@map("tasks")
}

// The routing/acknowledgement chain (doc 06). One row per "hop."
model TaskAssignment {
  id                  String           @id @default(uuid())
  taskId              String           @map("task_id")
  assigneeType        AssigneeType     @map("assignee_type")
  assigneeUserId      String?          @map("assignee_user_id") // set iff assigneeType=USER
  assigneeTeamId      String?          @map("assignee_team_id") // set iff assigneeType=TEAM
  assignedById        String           @map("assigned_by")
  parentAssignmentId  String?          @map("parent_assignment_id")
  status              AssignmentStatus @default(PENDING_ACKNOWLEDGEMENT)
  respondedById       String?          @map("responded_by")
  respondedAt         DateTime?        @map("responded_at")
  declineReason       String?          @map("decline_reason")
  isCurrent           Boolean          @default(true) @map("is_current")
  createdAt           DateTime         @default(now()) @map("created_at")

  task              Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assigneeUser      User?            @relation("AssignmentAssigneeUser", fields: [assigneeUserId], references: [id])
  assigneeTeam      Team?            @relation("AssignmentAssigneeTeam", fields: [assigneeTeamId], references: [id])
  assignedBy        User             @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  respondedBy       User?            @relation("AssignmentRespondedBy", fields: [respondedById], references: [id])
  parentAssignment  TaskAssignment?  @relation("AssignmentChain", fields: [parentAssignmentId], references: [id])
  childAssignments  TaskAssignment[] @relation("AssignmentChain")
  updates           TaskUpdate[]
  reviews           TaskReview[]

  @@index([taskId])
  @@index([assigneeUserId])
  @@index([assigneeTeamId])
  @@index([taskId, isCurrent])
  @@map("task_assignments")
}

model TaskChecklistItem {
  id          String   @id @default(uuid())
  taskId      String   @map("task_id")
  label       String
  isDone      Boolean  @default(false) @map("is_done")
  position    Int
  createdById String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])

  @@index([taskId])
  @@map("task_checklist_items")
}

model TaskComment {
  id        String    @id @default(uuid())
  taskId    String    @map("task_id")
  userId    String    @map("user_id")
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])
  attachments TaskAttachment[]

  @@index([taskId])
  @@map("task_comments")
}

model TaskUpdate {
  id            String     @id @default(uuid())
  taskId        String     @map("task_id")
  assignmentId  String?    @map("assignment_id")
  userId        String     @map("user_id")
  percentage    Int?
  statusSnapshot TaskStatus? @map("status_snapshot")
  note          String?
  createdAt     DateTime   @default(now()) @map("created_at")

  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignment TaskAssignment? @relation(fields: [assignmentId], references: [id])
  user       User            @relation(fields: [userId], references: [id])

  @@index([taskId])
  @@map("task_updates")
}

// Phase 2B — docs/architecture/16-work-files-attachments.md. This model predates Phase 2B
// (seeded in the original doc 03 schema, never wired to any service/route/UI until now) —
// extended here rather than replaced, per that phase's instruction to reuse an existing
// attachment concept if one exists. `commentId` is the pre-existing, still-untouched link
// to the old TaskComment feature; `messageId` is the Phase 2A TaskMessage link. Binary
// content is never stored here — `storagePath` is an opaque, server-generated key into the
// StorageService, never a client-supplied path or the original filename.
//
// Phase 2C — docs/architecture/17-phase2c-project-workspace-architecture-report.md §6.5:
// `taskId` widened from required to nullable, `projectId` added, with a CHECK constraint
// ensuring exactly one of the two is ever set — by construction, an attachment can never
// carry a taskId/projectId pair that disagree about which workspace it belongs to.
model TaskAttachment {
  id           String    @id @default(uuid())
  taskId       String?   @map("task_id")
  projectId    String?   @map("project_id")
  commentId    String?   @map("comment_id")
  messageId    String?   @map("message_id")
  uploadedById String    @map("uploaded_by")
  storagePath  String    @map("storage_path")
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    BigInt    @map("size_bytes")
  isDeleted    Boolean   @default(false) @map("is_deleted")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  task       Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  comment    TaskComment? @relation(fields: [commentId], references: [id])
  message    TaskMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy User         @relation(fields: [uploadedById], references: [id])

  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@index([messageId])
  @@map("task_attachments")
}

model TaskDependency {
  id              String         @id @default(uuid())
  taskId          String         @map("task_id")
  dependsOnTaskId String         @map("depends_on_task_id")
  type            DependencyType @default(BLOCKS)

  task        Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTask Task @relation("DependsOnTask", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnTaskId])
  @@map("task_dependencies")
}

model TaskReview {
  id           String         @id @default(uuid())
  taskId       String         @map("task_id")
  assignmentId String         @map("assignment_id")
  reviewerId   String         @map("reviewer_id")
  decision     ReviewDecision
  notes        String?
  createdAt    DateTime       @default(now()) @map("created_at")

  task       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignment TaskAssignment @relation(fields: [assignmentId], references: [id])
  reviewer   User           @relation(fields: [reviewerId], references: [id])

  @@index([taskId])
  @@map("task_reviews")
}

model Tag {
  id             String  @id @default(uuid())
  organizationId String? @map("organization_id")
  name           String
  color          String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tasks        TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId String @map("task_id")
  tagId  String @map("tag_id")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@map("task_tags")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications & audit
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  type            String
  payload         Json            @default("{}")
  relatedTaskId   String?         @map("related_task_id")
  isRead          Boolean         @default(false) @map("is_read")
  deliveryChannel DeliveryChannel @default(IN_APP) @map("delivery_channel")
  createdAt       DateTime        @default(now()) @map("created_at")

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedTask Task? @relation(fields: [relatedTaskId], references: [id])

  @@index([userId, isRead])
  @@map("notifications")
}

// Append-only. DB-level immutability (REVOKE UPDATE/DELETE from app role) is applied via
// a raw-SQL migration — see doc 12 §12.7.
model AuditLog {
  id             String       @id @default(uuid())
  organizationId String?      @map("organization_id")
  actorId        String       @map("actor_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String       @map("entity_id")
  before         Json?
  after          Json?
  reason         String?
  source         AuditSource  @default(UI)
  createdAt      DateTime     @default(now()) @map("created_at")

  // Phase 2A addition — docs/architecture/15-task-conversation.md "Activity feed reuses
  // the audit log". Nullable/additive: every Phase 1 write path is untouched; call sites
  // that already know the related task (every task/assignment/review/checklist/comment
  // mutation) now also pass it, so a task's full activity history is one indexed query
  // instead of a parallel event-sourcing table.
  taskId String? @map("task_id")

  // Phase 2C addition — docs/architecture/17-phase2c-project-workspace-architecture-report.md
  // §6.7/§15. Third use of this exact additive-nullable-column pattern (after taskId
  // above in Phase 2A): a project's full activity history becomes one indexed query over
  // this same table, never a parallel one.
  projectId String? @map("project_id")

  // Phase 3 addition — docs/architecture/19-phase3-daily-work-cycle-architecture-report.md
  // §12/§20. Fourth use of the same additive-nullable-column pattern: a day's full
  // activity history becomes one indexed query over this same table, never a parallel one.
  workdayId String? @map("workday_id")

  organization Organization? @relation(fields: [organizationId], references: [id])
  actor        User          @relation(fields: [actorId], references: [id])
  task         Task?         @relation("AuditLogTask", fields: [taskId], references: [id])
  project      Project?      @relation("AuditLogProject", fields: [projectId], references: [id], onDelete: SetNull)
  workday      Workday?      @relation(fields: [workdayId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([taskId, createdAt])
  @@index([projectId, createdAt])
  @@index([workdayId, createdAt])
  @@map("audit_logs")
}

// Kept per the approved schema for forward compatibility; unused by any Phase 1 code
// path (AI is out of scope for Phase 1).
model AiInteraction {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String?  @map("organization_id")
  feature        String
  input          Json
  output         Json
  model          String?
  tokensUsed     Int?     @map("tokens_used")
  acceptedByUser Boolean? @map("accepted_by_user")
  createdAt      DateTime @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@map("ai_interactions")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2A — Task Conversations (docs/architecture/15-task-conversation.md)
//
// Authorization invariant (enforced in code, not by any table here): a user may read or
// write in a task's conversation if and only if TaskService.canViewTask() says they can
// view the task itself. These tables carry conversation *content*, never a competing
// membership/authorization source — there is deliberately no "conversation_members"
// table (see doc 15 for why).
// ─────────────────────────────────────────────────────────────────────────

// Exactly one per task OR one per project — the unique `taskId`/`projectId` (each unique
// individually) plus the CHECK constraint added in the Phase 2C migration
// (docs/architecture/17-phase2c-project-workspace-architecture-report.md §6.4) are what
// make "no duplicate primary conversation" and "never both/neither" database guarantees,
// not just application convention.
//
// Generalized from Phase 2A's TaskConversation (task-only) rather than duplicated into a
// parallel ProjectConversation model — TaskMessage/TaskMessageMention/
// TaskMessageReaction/TaskConversationRead are completely unchanged by this, since they
// only ever reference conversationId, never taskId directly. Authorization is still
// enforced in code, never by this table: a task-scoped conversation follows
// canAccessConversation (Phase 2A, unchanged); a project-scoped one follows project
// membership (doc 17 §8/§9) — see ConversationService.
model Conversation {
  id             String   @id @default(uuid())
  taskId         String?  @unique @map("task_id")
  projectId      String?  @unique @map("project_id")
  organizationId String?  @map("organization_id") // denormalized from task/project's workspace, query convenience only — never authoritative
  createdAt      DateTime @default(now()) @map("created_at")

  task     Task?                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project  Project?               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages TaskMessage[]
  reads    TaskConversationRead[]

  // Table name intentionally left as "task_conversations" (not renamed to "conversations")
  // — Prisma's migration diffing treats an @@map rename as DROP+CREATE, which would have
  // destroyed this table's existing rows. Only the Prisma-level model name changed
  // (TaskConversation -> Conversation); the physical table is untouched, zero data risk.
  @@map("task_conversations")
  // CHECK (exactly one of task_id / project_id set) added via raw-SQL migration
}

// Always human-authored (see NotificationService/AuditLog for system-generated events —
// doc 15 "system activity is never a fake TaskMessage row").
model TaskMessage {
  id                String    @id @default(uuid())
  conversationId    String    @map("conversation_id")
  senderId          String    @map("sender_id")
  parentMessageId   String?   @map("parent_message_id")
  body              String
  isEdited          Boolean   @default(false) @map("is_edited")
  editedAt          DateTime? @map("edited_at")
  isDeleted         Boolean   @default(false) @map("is_deleted")
  deletedAt         DateTime? @map("deleted_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  conversation    Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User                  @relation(fields: [senderId], references: [id])
  parentMessage   TaskMessage?          @relation("MessageReplies", fields: [parentMessageId], references: [id])
  replies         TaskMessage[]         @relation("MessageReplies")
  mentions        TaskMessageMention[]
  reactions       TaskMessageReaction[]
  attachments     TaskAttachment[]

  @@index([conversationId, createdAt])
  @@index([parentMessageId])
  @@map("task_messages")
}

model TaskMessageMention {
  id               String   @id @default(uuid())
  messageId        String   @map("message_id")
  mentionedUserId  String   @map("mentioned_user_id")
  createdAt        DateTime @default(now()) @map("created_at")

  message       TaskMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUser User        @relation(fields: [mentionedUserId], references: [id])

  @@unique([messageId, mentionedUserId])
  @@index([mentionedUserId])
  @@map("task_message_mentions")
}

// Normalized (one row per user+emoji), not a JSON blob on the message — doc 15 §Reactions.
model TaskMessageReaction {
  id        String   @id @default(uuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")

  message TaskMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id])

  @@unique([messageId, userId, emoji])
  @@map("task_message_reactions")
}

// Single last-read cursor per (conversation, user) — deliberately not a per-message read
// row per user (doc 15 §Unread state: "simpler cursor model is sufficient").
model TaskConversationRead {
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  lastReadAt     DateTime @map("last_read_at")

  conversation Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@map("task_conversation_reads")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — Daily Work Cycle (docs/architecture/19-phase3-daily-work-cycle-architecture-report.md)
//
// A thin, personal, reference-only layer over the existing work graph — never a second
// task system. Task/TaskAssignment/the task lifecycle are completely unchanged by
// anything below; DailyPlanItem always references an existing Task by id, never copies
// any of its fields (doc 19 §13). Daily planning is personal by default and, in Phase 3,
// exclusively so: every consumer of these tables only ever operates on the calling
// user's own rows (doc 19 §27) — there is deliberately no "plan for someone else"
// capability yet.
// ─────────────────────────────────────────────────────────────────────────

// One row per (user, local calendar day) — an anchor for that day's start/close, not a
// container that must have any DailyPlanItems to exist meaningfully (doc 19 §11). Status
// (NOT_STARTED / OPEN / CLOSED) is deliberately NOT a stored column — it's derived from
// startedAt/closedAt alone (doc 19 §22), so it can never drift from the data it describes.
model Workday {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  // The user's LOCAL calendar date (no time component) — computed server-side from
  // User.defaultTimezone at write time, never from raw server `now()` alone (doc 19 §12,
  // §31 — this is the fix for the pre-existing timezone bug in ReportingService's
  // bucketByDueDate). @db.Date keeps this unambiguous: a plain date, not an instant.
  workDate       DateTime  @db.Date @map("work_date")
  // Set once, lazily, on first engagement with that day — "starting the day" is an
  // implicit side effect of touching any Phase 3 endpoint that date, not a button the
  // user must remember to press first (doc 19 §5/§22).
  startedAt      DateTime? @map("started_at")
  // Set once, only by a successful, fully-validated Close (doc 19 §8) — every
  // non-terminal DailyPlanItem for this day must have an explicit disposition first.
  closedAt       DateTime? @map("closed_at")
  reflectionNote String?   @map("reflection_note")
  createdAt      DateTime  @default(now()) @map("created_at")

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     DailyPlanItem[]
  auditLogs AuditLog[]

  // Exactly one Workday per user per local day — also serves as the natural lookup index,
  // so no separate @@index is needed (doc 19 §12).
  @@unique([userId, workDate])
  @@map("workdays")
}

// "This task is on my plan for this specific day," plus its local status/timing — the
// one genuine decision this whole model exists to record (doc 19 §11). Every other
// concept the brief considered (PlannedTask, TimeBlock, WorkSession, UnplannedWork,
// CarryForward, DailyReview) folds into fields on this one table rather than becoming a
// separate entity — see doc 19 §11 for the per-concept justification.
model DailyPlanItem {
  id        String              @id @default(uuid())
  workdayId String              @map("workday_id")
  taskId    String              @map("task_id")
  status    DailyPlanItemStatus @default(PLANNED)
  // App-assigned ordering within the day (drag-and-drop is a UI concern over this same
  // field, not a new data need — doc 19 §6).
  position  Int                 @default(0)
  // User-declared, never clock-inferred (doc 19 §18): true only when the user explicitly
  // marks an item as "wasn't part of my original plan," not derived from when it was added.
  isUnplanned Boolean           @default(false) @map("is_unplanned")
  // The day-specific estimate — deliberately separate from Task.estimatedDurationMinutes
  // (doc 19 §13): the task's own field is a general, set-once default; this is "what I
  // actually expect to spend on it today," which may legitimately differ.
  plannedDurationMinutes Int?   @map("planned_duration_minutes")
  // Optional "I intend to do this from X to Y today" — no conflict-detection, no
  // calendar-grid UI; just a hook a future Calendar phase can plot against with zero
  // schema change (doc 19 §16/§23).
  scheduledStart DateTime?      @map("scheduled_start")
  scheduledEnd   DateTime?      @map("scheduled_end")
  // First "Start" press / "Complete" press — one coarse actual-elapsed-time signal,
  // deliberately without WorkSession-style pause/resume history (doc 19 §17). Never
  // caller-supplied; always set to the server's `now()` by the transition endpoints that
  // own them (doc 19 §28 — prevents falsified time entries).
  startedAt   DateTime?         @map("started_at")
  completedAt DateTime?         @map("completed_at")
  // Carry-forward chain — a status transition plus a link, not a new entity (doc 19 §19).
  // Points at the prior day's item this one continues from. The reverse direction ("what
  // was I carried to") is a simple reverse lookup (findFirst where carriedFromItemId =
  // this.id) rather than a second stored/related FK column — at most one successor is
  // ever created per source (its own status flips to the terminal CARRIED_FORWARD exactly
  // once when that happens), so a single-column, single-relation self-link is sufficient
  // to preserve full bidirectional history without the added complexity of a dual-FK
  // self-relation on one model (a deliberate simplification over doc 19 §12's two-column
  // sketch — identical guarantees, fewer moving parts).
  carriedFromItemId String?          @map("carried_from_item_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  workday        Workday         @relation(fields: [workdayId], references: [id], onDelete: Cascade)
  // Tasks are never hard-deleted in this codebase (only cancelled — doc 05) — this
  // cascade is a structural safety net for an unreachable case today, not an active path,
  // matching the same reasoning already used for Workspace's owner cascade.
  task              Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  carriedFromItem   DailyPlanItem?  @relation("CarryForwardChain", fields: [carriedFromItemId], references: [id], onDelete: SetNull)
  carriedForwardTo  DailyPlanItem[] @relation("CarryForwardChain")

  // A task can appear AT MOST ONCE per specific day's plan (prevents duplicate planning
  // the same day) while remaining fully plannable again on a DIFFERENT day, since
  // workdayId differs — doc 19 §12/§13's exact requirement, enforced at the DB level as a
  // second layer of defense beyond the application check (doc 19 §27).
  @@unique([workdayId, taskId])
  @@index([workdayId, position])
  @@index([taskId])
  @@index([carriedFromItemId])
  @@map("daily_plan_items")
}
